{
    "name": "next-tech/moonshine-lunar-chat",
    "description": "Chat UI components for MoonShine 4",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleg Danilyuk",
            "email": "danilyuk_oleg@vk.com",
            "homepage": "https://github.com/NextTech-coder"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "NextTech\\MoonShineLunarChat\\": "src/"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "version": "1.0.0",
    "require-dev": {
